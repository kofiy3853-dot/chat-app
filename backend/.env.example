# Database - Local PostgreSQL (Docker)
DATABASE_URL="postgresql://campus_chat:campus_chat_dev@localhost:5432/campus_chat"
DIRECT_URL="postgresql://campus_chat:campus_chat_dev@localhost:5432/campus_chat"

# Redis (Optional: uncomment for horizontal scaling)
# REDIS_URL=redis://localhost:6379

# Morph AI
MORPH_API_KEY=your-morph-api-key
MODERATION_DISABLED=false

# Supabase Storage Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# JWT
JWT_SECRET=generate-a-random-256-bit-secret
JWT_EXPIRE=7d

# Server
PORT=5000
FRONTEND_URL=http://localhost:3000

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# TURN Server (WebRTC relay)
TURN_SERVER_URL=turn:your-turn-server:3478
TURN_USERNAME=your-turn-username
TURN_CREDENTIAL=your-turn-credential

# OneSignal Configuration
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key

# Nana AI Configuration
OPENROUTER_API_KEY=your-openrouter-api-key

# Firebase Admin configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
